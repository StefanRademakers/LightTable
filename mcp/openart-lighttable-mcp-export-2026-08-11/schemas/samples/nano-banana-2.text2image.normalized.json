          "1K",
          "2K",
          "4K"
        ]
      },
      "autoEnhancePrompt": {
        "default": false,
        "type": "boolean"
      }
    },
    "required": [
      "prompt",
      "imageCount",
      "aspectRatio",
      "resolution",
      "autoEnhancePrompt"
