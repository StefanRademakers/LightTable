{
  "schemaVersion": 1,
  "category": "layer",
  "$defs": {
    "layerId": { "type": "string", "minLength": 1, "maxLength": 512, "x-lighttable-control": "layer-id" }
  },
  "commands": {
    "layer.autoAlign": {
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["referenceLayerId", "targetLayerId"],
        "properties": {
          "referenceLayerId": { "$ref": "#/$defs/layerId" },
          "targetLayerId": { "$ref": "#/$defs/layerId" }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["changed", "referenceLayerId", "targetLayerId"],
        "properties": {
          "changed": { "type": "boolean" },
          "referenceLayerId": { "$ref": "#/$defs/layerId" },
          "targetLayerId": { "$ref": "#/$defs/layerId" }
        }
      }
    }
  }
}
