{
  "schemaVersion": 1,
  "category": "effects",
  "$defs": {
    "layerId": { "type": "string", "minLength": 1, "maxLength": 512, "x-lighttable-control": "layer-id" },
    "pair": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "type": "number", "minimum": -10000000, "maximum": 10000000 }
    },
    "tilt": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "type": "number", "minimum": -90, "maximum": 90 }
    },
    "settings": {
      "type": "object", "additionalProperties": false,
      "required": ["diameterPx", "strength", "hardness", "flow", "spacing", "smooth", "pressureSize", "pressureStrength"],
      "properties": {
        "diameterPx": { "type": "number", "minimum": 1, "maximum": 2000 },
        "strength": { "type": "number", "minimum": 0.01, "maximum": 2 },
        "hardness": { "type": "number", "minimum": 0, "maximum": 1 },
        "flow": { "type": "number", "minimum": 0.01, "maximum": 1 },
        "spacing": { "type": "number", "minimum": 0.01, "maximum": 1 },
        "smooth": { "type": "number", "minimum": 0, "maximum": 2 },
        "pressureSize": { "type": "boolean" },
        "pressureStrength": { "type": "boolean" }
      }
    },
    "sample": {
      "type": "object", "additionalProperties": false,
      "required": ["positionPx", "deltaPx", "pressure", "tilt", "timeMs"],
      "properties": {
        "positionPx": { "$ref": "#/$defs/pair" },
        "deltaPx": { "$ref": "#/$defs/pair" },
        "pressure": { "type": "number", "minimum": 0, "maximum": 1 },
        "tilt": { "$ref": "#/$defs/tilt" },
        "timeMs": { "type": "number", "minimum": 0, "maximum": 9007199254740991 }
      }
    }
  },
  "commands": {
    "warp.applyStroke": {
      "input": {
        "type": "object", "additionalProperties": false,
        "required": ["layerId", "mode", "settings", "samples", "startedAtMs", "durationMs"],
        "properties": {
          "layerId": { "$ref": "#/$defs/layerId" },
          "mode": { "type": "string", "enum": ["push", "twirl-cw", "twirl-ccw", "pinch", "bloat", "smooth", "reconstruct", "freeze", "thaw"] },
          "settings": { "$ref": "#/$defs/settings" },
          "samples": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/sample" } },
          "startedAtMs": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
          "durationMs": { "type": "number", "minimum": 0, "maximum": 3600000 }
        }
      },
      "result": {
        "type": "object", "additionalProperties": false, "required": ["layerId", "strokeId", "sampleCount"],
        "properties": {
          "layerId": { "$ref": "#/$defs/layerId" },
          "strokeId": { "type": "string", "minLength": 1, "maxLength": 512 },
          "sampleCount": { "type": "integer", "minimum": 1, "maximum": 4096 }
        }
      }
    }
  }
}
