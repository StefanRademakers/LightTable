{
  "schemaVersion": 1,
  "category": "file",
  "$defs": {
    "artifactId": { "type": "string", "title": "Artifact ID", "minLength": 1, "maxLength": 256 },
    "documentId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "layerId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "emptyInput": { "type": "object", "additionalProperties": false, "properties": {} },
    "compatibilityFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "path", "message"],
      "properties": {
        "severity": { "type": "string", "enum": ["degraded-editability", "degraded-fidelity", "blocking"] },
        "code": {
          "type": "string",
          "enum": [
            "affine-raster-unbaked", "attached-adjustment-baked", "face-warp-baked",
            "grade-unprojectable", "layer-style-pattern-resource", "lens-fx-unprojectable",
            "native-adjustment-unprojectable", "psd-8-bit-export", "smart-object-source-missing",
            "text-preserved-descriptor", "text-raster-backed", "vector-preserved-descriptor",
            "vector-raster-backed"
          ]
        },
        "path": { "type": "string", "maxLength": 4096 },
        "message": { "type": "string", "minLength": 1, "maxLength": 8192 }
      }
    },
    "exportArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "mediaType", "byteLength", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "kind": { "type": "string", "enum": ["native-document", "png-export", "jpeg-export", "webp-export", "tiff-export", "psd-export", "svg-export"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 255 },
        "byteLength": { "type": "integer", "minimum": 0, "maximum": 536870912 },
        "createdAt": { "type": "number", "minimum": 0 },
        "compatibilityFindings": {
          "type": "array", "maxItems": 65536,
          "items": { "$ref": "#/$defs/compatibilityFinding" }
        }
      }
    },
    "pixelClipboardArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "mediaType", "byteLength", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "kind": { "type": "string", "const": "pixel-clipboard" },
        "name": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "mediaType": { "type": "string", "enum": ["image/png", "image/webp"] },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "createdAt": { "type": "number", "minimum": 0 }
      }
    },
    "documentBounds": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": -10000000, "maximum": 10000000 },
        "y": { "type": "number", "minimum": -10000000, "maximum": 10000000 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000000 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000000 }
      }
    }
  },
  "commands": {
    "file.exportNative": {
      "input": { "$ref": "#/$defs/emptyInput", "type": "object", "additionalProperties": false, "properties": {} },
      "result": {
        "type": "object", "additionalProperties": false, "required": ["artifact"],
        "properties": { "artifact": { "allOf": [
          { "$ref": "#/$defs/exportArtifact" },
          { "type": "object", "properties": { "kind": { "const": "native-document" } } }
        ] } }
      }
    },
    "file.exportPng": {
      "input": { "$ref": "#/$defs/emptyInput", "type": "object", "additionalProperties": false, "properties": {} },
      "result": {
        "type": "object", "additionalProperties": false, "required": ["artifact"],
        "properties": { "artifact": { "allOf": [
          { "$ref": "#/$defs/exportArtifact" },
          { "type": "object", "properties": { "kind": { "const": "png-export" } } }
        ] } }
      }
    },
    "file.exportBitmap": {
      "input": {
        "type": "object", "additionalProperties": false, "required": ["format"],
        "properties": { "format": { "type": "string", "enum": ["jpeg", "webp", "tiff"] } }
      },
      "result": {
        "type": "object", "additionalProperties": false, "required": ["artifact"],
        "properties": { "artifact": { "allOf": [
          { "$ref": "#/$defs/exportArtifact" },
          { "type": "object", "properties": { "kind": { "enum": ["jpeg-export", "webp-export", "tiff-export"] } } }
        ] } }
      }
    },
    "file.exportPsd": {
      "input": { "$ref": "#/$defs/emptyInput", "type": "object", "additionalProperties": false, "properties": {} },
      "result": {
        "type": "object", "additionalProperties": false, "required": ["artifact"],
        "properties": { "artifact": { "allOf": [
          { "$ref": "#/$defs/exportArtifact" },
          { "type": "object", "properties": { "kind": { "const": "psd-export" } } }
        ] } }
      }
    },
    "file.exportSvg": {
      "input": { "$ref": "#/$defs/emptyInput", "type": "object", "additionalProperties": false, "properties": {} },
      "result": {
        "type": "object", "additionalProperties": false, "required": ["artifact"],
        "properties": { "artifact": { "allOf": [
          { "$ref": "#/$defs/exportArtifact" },
          { "type": "object", "properties": { "kind": { "const": "svg-export" } } }
        ] } }
      }
    },
    "file.openArtifact": {
      "input": {
        "type": "object", "additionalProperties": false, "required": ["artifactId"],
        "properties": { "artifactId": { "$ref": "#/$defs/artifactId" } }
      },
      "result": {
        "type": "object", "additionalProperties": false, "required": ["documentId"],
        "properties": { "documentId": { "$ref": "#/$defs/documentId" } }
      }
    },
    "layer.placeArtifact": {
      "input": {
        "type": "object", "additionalProperties": false, "required": ["artifactId"],
        "properties": {
          "artifactId": { "$ref": "#/$defs/artifactId" },
          "name": {
            "type": "string", "title": "Layer name", "minLength": 1, "maxLength": 255,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
          },
          "x": { "type": "number", "title": "Document X", "minimum": -10000000, "maximum": 10000000 },
          "y": { "type": "number", "title": "Document Y", "minimum": -10000000, "maximum": 10000000 }
        }
      },
      "result": {
        "type": "object", "additionalProperties": false,
        "required": ["layerId", "width", "height"],
        "properties": {
          "layerId": { "$ref": "#/$defs/layerId" },
          "width": { "type": "integer", "minimum": 1, "maximum": 32768 },
          "height": { "type": "integer", "minimum": 1, "maximum": 32768 }
        }
      }
    },
    "selection.copyPixels": {
      "input": {
        "type": "object", "additionalProperties": false, "required": ["source"],
        "properties": { "source": { "type": "string", "enum": ["active-layer", "merged"] } }
      },
      "result": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "bounds", "artifact"],
        "properties": {
          "source": { "type": "string", "enum": ["active-layer", "merged"] },
          "bounds": { "$ref": "#/$defs/documentBounds" },
          "artifact": { "$ref": "#/$defs/pixelClipboardArtifact" }
        }
      }
    },
    "selection.cutPixels": {
      "input": { "$ref": "#/$defs/emptyInput", "type": "object", "additionalProperties": false, "properties": {} },
      "result": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "bounds", "artifact"],
        "properties": {
          "source": { "type": "string", "const": "active-layer" },
          "bounds": { "$ref": "#/$defs/documentBounds" },
          "artifact": { "$ref": "#/$defs/pixelClipboardArtifact" }
        }
      }
    },
    "selection.pastePixels": {
      "input": {
        "type": "object", "additionalProperties": false,
        "required": ["artifactId", "bounds"],
        "properties": {
          "artifactId": { "$ref": "#/$defs/artifactId" },
          "bounds": { "$ref": "#/$defs/documentBounds" },
          "name": {
            "type": "string", "title": "Layer name", "minLength": 1, "maxLength": 255,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
          },
          "target": {
            "type": "object", "additionalProperties": false,
            "required": ["channel"],
            "properties": {
              "channel": { "type": "string", "enum": ["pixels", "mask"] },
              "layerId": { "$ref": "#/$defs/layerId" }
            }
          }
        }
      },
      "result": {
        "type": "object", "additionalProperties": false,
        "required": ["layerId", "width", "height"],
        "properties": {
          "layerId": { "$ref": "#/$defs/layerId" },
          "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000000 },
          "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000000 }
        }
      }
    }
  }
}
