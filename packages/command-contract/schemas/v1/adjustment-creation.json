{
  "schemaVersion": 1,
  "category": "effects",
  "$defs": {
    "layerId": { "type": "string", "minLength": 1, "maxLength": 512, "x-lighttable-control": "layer-id" },
    "visibleKind": {
      "type": "string",
      "enum": [
        "grade", "lens-fx", "color-vibrance", "brightness-contrast", "levels",
        "curves", "exposure", "hue-saturation", "color-balance", "black-white",
        "photo-filter", "channel-mixer", "color-lookup", "selective-color", "invert",
        "posterize", "threshold", "gradient-map", "clarity-dehaze", "grain", "gaussian-blur",
        "high-pass", "smart-sharpen", "unsharp-mask", "motion-blur", "surface-blur", "median", "reduce-noise", "maximum", "minimum", "offset", "displace"
      ]
    },
    "localKind": { "type": "string", "enum": ["grade", "curves", "lens-fx"] },
    "posterizeSettings": {
      "type": "object", "additionalProperties": false,
      "required": ["posterizeLevels"],
      "properties": {
        "posterizeLevels": { "type": "integer", "minimum": 2, "maximum": 255, "default": 4 }
      }
    },
    "thresholdSettings": {
      "type": "object", "additionalProperties": false,
      "required": ["thresholdLevel"],
      "properties": {
        "thresholdLevel": { "type": "integer", "minimum": 1, "maximum": 255, "default": 128 }
      }
    },
    "gaussianBlurSettings": {
      "type": "object", "additionalProperties": false,
      "required": ["radius"],
      "properties": {
        "radius": { "type": "number", "minimum": 0, "maximum": 100, "default": 8 }
      }
    },
    "motionBlurSettings": {
      "type": "object", "additionalProperties": false,
      "required": ["angle", "distance"],
      "properties": {
        "angle": { "type": "number", "minimum": -180, "maximum": 180, "default": 0 },
        "distance": { "type": "number", "minimum": 0, "maximum": 512, "default": 10 }
      }
    },
    "surfaceBlurSettings": {
      "type": "object", "additionalProperties": false,
      "required": ["radius", "threshold"],
      "properties": {
        "radius": { "type": "number", "minimum": 1, "maximum": 100, "default": 5 },
        "threshold": { "type": "number", "minimum": 2, "maximum": 255, "default": 15 }
      }
    },
    "medianSettings": {
      "type": "object", "additionalProperties": false,
      "required": ["radius"],
      "properties": {
        "radius": { "type": "integer", "minimum": 1, "maximum": 100, "default": 1 }
      }
    },
    "highPassSettings": {
      "type": "object", "additionalProperties": false,
      "required": ["radius"],
      "properties": {
        "radius": { "type": "number", "minimum": 0.1, "maximum": 100, "default": 10 }
      }
    },
    "unsharpMaskSettings": {
      "type": "object", "additionalProperties": false,
      "required": ["amount", "radius", "threshold"],
      "properties": {
        "amount": { "type": "number", "minimum": 0, "maximum": 500, "default": 100 },
        "radius": { "type": "number", "minimum": 0.1, "maximum": 100, "default": 1 },
        "threshold": { "type": "number", "minimum": 0, "maximum": 255, "default": 0 }
      }
    },
    "smartSharpenSettings": {
      "type": "object", "additionalProperties": false,
      "required": ["amount", "radius", "reduceNoise", "remove", "angle"],
      "properties": {
        "amount": { "type": "number", "minimum": 0, "maximum": 500, "default": 100 },
        "radius": { "type": "number", "minimum": 0.1, "maximum": 64, "default": 1 },
        "reduceNoise": { "type": "number", "minimum": 0, "maximum": 100, "default": 10 },
        "remove": { "type": "string", "enum": ["gaussian", "lens", "motion"], "default": "gaussian" },
        "angle": { "type": "number", "minimum": -180, "maximum": 180, "default": 0 }
      }
    },
    "reduceNoiseSettings": {
      "type": "object", "additionalProperties": false,
      "required": ["strength", "preserveDetails", "reduceColorNoise", "sharpenDetails"],
      "properties": {
        "strength": { "type": "integer", "minimum": 0, "maximum": 10, "default": 6 },
        "preserveDetails": { "type": "number", "minimum": 0, "maximum": 100, "default": 60 },
        "reduceColorNoise": { "type": "number", "minimum": 0, "maximum": 100, "default": 45 },
        "sharpenDetails": { "type": "number", "minimum": 0, "maximum": 100, "default": 25 }
      }
    },
    "offsetSettings": {
      "type": "object", "additionalProperties": false,
      "required": ["horizontal", "vertical", "edgeMode"],
      "properties": {
        "horizontal": { "type": "integer", "minimum": -100000, "maximum": 100000, "default": 0 },
        "vertical": { "type": "integer", "minimum": -100000, "maximum": 100000, "default": 0 },
        "edgeMode": { "type": "string", "enum": ["transparent", "clamp", "wrap"], "default": "wrap" }
      }
    },
    "displaceSettings": {
      "type": "object", "additionalProperties": false,
      "required": ["horizontalScale", "verticalScale", "mapAssetId", "edgeMode", "interpolation"],
      "properties": {
        "horizontalScale": { "type": "number", "minimum": -999, "maximum": 999, "default": 10 },
        "verticalScale": { "type": "number", "minimum": -999, "maximum": 999, "default": 10 },
        "mapAssetId": {
          "description": "Canonical raster layer ID in the same document; null produces an exact bypass.",
          "oneOf": [
            { "$ref": "#/$defs/layerId" },
            { "type": "null" }
          ]
        },
        "edgeMode": { "type": "string", "enum": ["transparent", "clamp", "wrap"], "default": "clamp" },
        "interpolation": { "type": "string", "enum": ["bilinear", "bicubic"], "default": "bicubic" }
      }
    },
    "morphologySettings": {
      "type": "object", "additionalProperties": false,
      "required": ["radius", "shape"],
      "properties": {
        "radius": { "type": "integer", "minimum": 1, "maximum": 500, "default": 1 },
        "shape": { "type": "string", "enum": ["round", "square"], "default": "round" }
      }
    },
    "gradientMapColorStop": {
      "type": "object", "additionalProperties": false,
      "required": ["position", "midpoint", "color"],
      "properties": {
        "position": { "type": "number", "minimum": 0, "maximum": 1 },
        "midpoint": { "type": "number", "minimum": 0, "maximum": 1 },
        "color": {
          "type": "object", "additionalProperties": false,
          "required": ["r", "g", "b"],
          "properties": {
            "r": { "type": "number", "minimum": 0, "maximum": 1 },
            "g": { "type": "number", "minimum": 0, "maximum": 1 },
            "b": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "gradientMapOpacityStop": {
      "type": "object", "additionalProperties": false,
      "required": ["position", "midpoint", "opacity"],
      "properties": {
        "position": { "type": "number", "minimum": 0, "maximum": 1 },
        "midpoint": { "type": "number", "minimum": 0, "maximum": 1 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "gradientMapSettings": {
      "type": "object", "additionalProperties": false,
      "required": ["colorStops", "opacityStops"],
      "properties": {
        "colorStops": {
          "type": "array", "minItems": 2, "maxItems": 8,
          "items": { "$ref": "#/$defs/gradientMapColorStop" }
        },
        "opacityStops": {
          "type": "array", "minItems": 2, "maxItems": 8,
          "items": { "$ref": "#/$defs/gradientMapOpacityStop" }
        },
        "reverse": { "type": "boolean", "default": false },
        "dither": { "type": "boolean", "default": false },
        "interpolation": {
          "type": "string", "enum": ["classic", "perceptual", "linear", "smooth"],
          "default": "classic"
        }
      }
    }
  },
  "commands": {
    "adjustment.create": {
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "placement"],
        "properties": {
          "kind": { "$ref": "#/$defs/visibleKind" },
          "placement": { "type": "string", "enum": ["local", "attached", "adjustment-layer"] },
          "layerId": { "$ref": "#/$defs/layerId" },
          "aboveLayerId": { "$ref": "#/$defs/layerId" },
          "settings": {
            "oneOf": [
              { "$ref": "#/$defs/posterizeSettings" },
              { "$ref": "#/$defs/thresholdSettings" },
              { "$ref": "#/$defs/gaussianBlurSettings" },
              { "$ref": "#/$defs/motionBlurSettings" },
              { "$ref": "#/$defs/surfaceBlurSettings" },
              { "$ref": "#/$defs/medianSettings" },
              { "$ref": "#/$defs/highPassSettings" },
              { "$ref": "#/$defs/unsharpMaskSettings" },
              { "$ref": "#/$defs/smartSharpenSettings" },
              { "$ref": "#/$defs/reduceNoiseSettings" },
              { "$ref": "#/$defs/morphologySettings" },
              { "$ref": "#/$defs/offsetSettings" },
              { "$ref": "#/$defs/displaceSettings" },
              { "$ref": "#/$defs/gradientMapSettings" }
            ]
          }
        },
        "oneOf": [
          {
            "type": "object", "required": ["kind", "placement", "layerId"],
            "properties": {
              "kind": { "$ref": "#/$defs/localKind" },
              "placement": { "const": "local" }
            },
            "not": { "type": "object", "required": ["aboveLayerId"] }
          },
          {
            "type": "object", "required": ["kind", "placement", "layerId"],
            "properties": { "placement": { "const": "attached" } },
            "not": { "type": "object", "required": ["aboveLayerId"] }
          },
          {
            "type": "object", "required": ["kind", "placement"],
            "properties": { "placement": { "const": "adjustment-layer" } },
            "not": { "type": "object", "required": ["layerId"] }
          }
        ],
        "allOf": [
          {
            "if": { "type": "object", "required": ["settings"] },
            "then": {
              "oneOf": [
                {
                  "type": "object", "required": ["kind", "settings"],
                  "properties": {
                    "kind": { "const": "gaussian-blur" },
                    "settings": { "$ref": "#/$defs/gaussianBlurSettings" }
                  }
                },
                {
                  "type": "object", "required": ["kind", "settings"],
                  "properties": {
                    "kind": { "const": "motion-blur" },
                    "settings": { "$ref": "#/$defs/motionBlurSettings" }
                  }
                },
                {
                  "type": "object", "required": ["kind", "settings"],
                  "properties": {
                    "kind": { "const": "surface-blur" },
                    "settings": { "$ref": "#/$defs/surfaceBlurSettings" }
                  }
                },
                {
                  "type": "object", "required": ["kind", "settings"],
                  "properties": {
                    "kind": { "const": "median" },
                    "settings": { "$ref": "#/$defs/medianSettings" }
                  }
                },
                {
                  "type": "object", "required": ["kind", "settings"],
                  "properties": {
                    "kind": { "const": "high-pass" },
                    "settings": { "$ref": "#/$defs/highPassSettings" }
                  }
                },
                {
                  "type": "object", "required": ["kind", "settings"],
                  "properties": {
                    "kind": { "const": "unsharp-mask" },
                    "settings": { "$ref": "#/$defs/unsharpMaskSettings" }
                  }
                },
                {
                  "type": "object", "required": ["kind", "settings"],
                  "properties": {
                    "kind": { "const": "smart-sharpen" },
                    "settings": { "$ref": "#/$defs/smartSharpenSettings" }
                  }
                },
                {
                  "type": "object", "required": ["kind", "settings"],
                  "properties": {
                    "kind": { "const": "reduce-noise" },
                    "settings": { "$ref": "#/$defs/reduceNoiseSettings" }
                  }
                },
                {
                  "type": "object", "required": ["kind", "settings"],
                  "properties": {
                    "kind": { "const": "offset" },
                    "settings": { "$ref": "#/$defs/offsetSettings" }
                  }
                },
                {
                  "type": "object", "required": ["kind", "settings"],
                  "properties": {
                    "kind": { "const": "displace" },
                    "settings": { "$ref": "#/$defs/displaceSettings" }
                  }
                },
                {
                  "type": "object", "required": ["kind", "settings"],
                  "properties": {
                    "kind": { "const": "maximum" },
                    "settings": { "$ref": "#/$defs/morphologySettings" }
                  }
                },
                {
                  "type": "object", "required": ["kind", "settings"],
                  "properties": {
                    "kind": { "const": "minimum" },
                    "settings": { "$ref": "#/$defs/morphologySettings" }
                  }
                },
                {
                  "type": "object", "required": ["kind", "settings"],
                  "properties": {
                    "kind": { "const": "posterize" },
                    "settings": { "$ref": "#/$defs/posterizeSettings" }
                  }
                },
                {
                  "type": "object", "required": ["kind", "settings"],
                  "properties": {
                    "kind": { "const": "threshold" },
                    "settings": { "$ref": "#/$defs/thresholdSettings" }
                  }
                },
                {
                  "type": "object", "required": ["kind", "settings"],
                  "properties": {
                    "kind": { "const": "gradient-map" },
                    "settings": { "$ref": "#/$defs/gradientMapSettings" }
                  }
                }
              ]
            }
          }
        ]
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "placement", "layerId"],
        "properties": {
          "kind": { "$ref": "#/$defs/visibleKind" },
          "placement": { "type": "string", "enum": ["local", "attached", "adjustment-layer"] },
          "layerId": { "$ref": "#/$defs/layerId" },
          "adjustmentId": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "oneOf": [
          {
            "type": "object", "required": ["kind", "placement", "layerId"],
            "properties": { "kind": { "$ref": "#/$defs/localKind" }, "placement": { "const": "local" } },
            "not": { "type": "object", "required": ["adjustmentId"] }
          },
          {
            "type": "object", "required": ["kind", "placement", "layerId", "adjustmentId"],
            "properties": { "placement": { "const": "attached" } }
          },
          {
            "type": "object", "required": ["kind", "placement", "layerId"],
            "properties": { "placement": { "const": "adjustment-layer" } },
            "not": { "type": "object", "required": ["adjustmentId"] }
          }
        ]
      }
    }
  }
}
