{
  "layer.duplicate": [
    { "layerId": "layer-photo" }
  ],
  "layer.delete": [
    { "layerIds": ["layer-draft"] }
  ],
  "layer.move": [
    { "layerId": "layer-title", "direction": "up" }
  ],
  "layer.setBlendMode": [
    { "layerId": "layer-texture", "blendMode": "soft-light" }
  ],
  "layer.setClipping": [
    { "layerId": "layer-grade", "clipping": true }
  ],
  "layer.setTransform": [
    { "layerId": "layer-title", "transform": { "a": 1, "b": 0, "c": 0, "d": 1, "tx": 32, "ty": 16 } }
  ],
  "layer.setMask": [
    { "layerId": "layer-photo", "operation": "add", "source": "reveal-all" },
    { "layerId": "layer-photo", "operation": "set-enabled", "enabled": false }
  ],
  "layer.setLock": [
    { "layerIds": ["layer-logo"], "lock": "position", "locked": true }
  ],
  "vector.create": [
    { "layerName": "Shape", "name": "Rectangle",
      "primitive": { "kind": "rectangle", "x": 0, "y": 0, "width": 180, "height": 90,
        "cornerRadii": [8, 8, 8, 8], "linkedCorners": true },
      "transform": { "a": 1, "b": 0, "c": 0, "d": 1, "tx": 32, "ty": 24 },
      "style": { "fill": { "type": "solid", "color": [0.1, 0.35, 0.9, 1] }, "opacity": 1 } },
    { "layerName": "Gradient Fill", "layerRole": "gradient-fill", "layerOpacity": 0.8,
      "layerBlendMode": "soft-light", "name": "Gradient Fill",
      "primitive": { "kind": "rectangle", "x": 0, "y": 0, "width": 1920, "height": 1080,
        "cornerRadii": [0, 0, 0, 0], "linkedCorners": true },
      "style": { "fill": { "kind": "gradient",
        "asset": { "id": "warm-cool", "name": "Warm Cool", "type": "solid", "smoothness": 1,
          "colorStops": [
            { "id": "cool", "position": 0, "midpoint": 0.5, "color": { "r": 0.1, "g": 0.3, "b": 1, "a": 1 } },
            { "id": "warm", "position": 1, "midpoint": 0.5, "color": { "r": 1, "g": 0.35, "b": 0.1, "a": 1 } }
          ],
          "opacityStops": [
            { "id": "opaque-0", "position": 0, "midpoint": 0.5, "opacity": 1 },
            { "id": "opaque-1", "position": 1, "midpoint": 0.5, "opacity": 1 }
          ], "roughness": 0, "seed": 0 },
        "shape": "linear", "coordinateSpace": "document",
        "transform": { "a": 900, "b": 0, "c": 0, "d": 900, "tx": 120, "ty": 540 },
        "reverse": false, "dither": true, "interpolation": "perceptual" },
        "stroke": null, "opacity": 1 } }
  ],
  "warp.applyStroke": [
    { "layerId": "layer-photo", "mode": "push",
      "settings": { "diameterPx": 120, "strength": 0.35, "hardness": 0.5,
        "flow": 0.5, "spacing": 0.1, "smooth": 0.2,
        "pressureSize": true, "pressureStrength": true },
      "samples": [
        { "positionPx": [220, 180], "deltaPx": [0, 0], "pressure": 1,
          "tilt": [0, 0], "timeMs": 1000 },
        { "positionPx": [245, 190], "deltaPx": [25, 10], "pressure": 0.8,
          "tilt": [0, 0], "timeMs": 1016 }
      ], "startedAtMs": 1000, "durationMs": 16 }
  ],
  "raster.fill": [
    { "layerId": "layer-photo", "channel": "pixels", "color": "#2f80ed",
      "preserveTransparency": false, "opacity": 1 }
  ],
  "raster.applyGradient": [
    { "layerId": "layer-photo", "channel": "pixels", "opacity": 0.8, "blendMode": "normal",
      "paint": { "kind": "gradient", "shape": "linear", "coordinateSpace": "document",
        "asset": { "id": "agent-sunset", "name": "Agent sunset", "type": "solid",
          "smoothness": 1, "roughness": 0, "seed": 0,
          "colorStops": [
            { "id": "color-start", "position": 0, "midpoint": 0.5,
              "color": { "r": 0.1, "g": 0.2, "b": 0.8, "a": 1 } },
            { "id": "color-end", "position": 1, "midpoint": 0.5,
              "color": { "r": 1, "g": 0.3, "b": 0.1, "a": 1 } }
          ],
          "opacityStops": [
            { "id": "opacity-start", "position": 0, "midpoint": 0.5, "opacity": 1 },
            { "id": "opacity-end", "position": 1, "midpoint": 0.5, "opacity": 1 }
          ] },
        "transform": { "a": 320, "b": 0, "c": 0, "d": 320, "tx": 40, "ty": 120 },
        "reverse": false, "dither": true, "interpolation": "perceptual" } }
  ],
  "tool.commitGesture": [
    {
      "kind": "brush-stroke",
      "parameters": {
        "layerId": "layer-paint",
        "channel": "pixels",
        "erase": false,
        "brush": {
          "presetId": "round",
          "size": 24,
          "hardness": 0.75,
          "opacity": 1,
          "flow": 0.5,
          "spacing": 0.05,
          "smooth": 0.2,
          "color": "#112233",
          "backgroundColor": "#ffffff"
        }
      },
      "samples": [
        { "x": 40, "y": 60, "pressure": 1 },
        { "x": 120, "y": 90, "pressure": 0.7 }
      ]
    },
    {
      "kind": "selection-rectangle",
      "parameters": { "mode": "replace" },
      "samples": [{ "x": 20, "y": 30 }, { "x": 260, "y": 180 }]
    },
    {
      "kind": "brush-stroke",
      "parameters": {
        "layerId": "layer-photo",
        "channel": "pixels",
        "erase": false,
        "brush": {
          "presetId": "round", "size": 80, "hardness": 0.5,
          "opacity": 1, "flow": 0.0525, "spacing": 0.25, "smooth": 0,
          "color": "#000000", "backgroundColor": "#ffffff"
        },
        "operator": {
          "operator": "tone", "mode": "dodge", "range": "midtones",
          "spongeMode": "saturate", "protectTones": true, "vibrance": true
        }
      },
      "samples": [
        { "x": 80, "y": 120, "pressure": 1 },
        { "x": 220, "y": 120, "pressure": 0.8 }
      ]
    },
    {
      "kind": "layer-translate",
      "parameters": { "layerId": "layer-title" },
      "samples": [{ "x": 0, "y": 0 }, { "x": 32, "y": 16 }]
    },
    {
      "kind": "brush-stroke",
      "parameters": {
        "layerId": "layer-retouch",
        "channel": "pixels",
        "erase": false,
        "brush": {
          "presetId": "round", "size": 42, "hardness": 0.6,
          "opacity": 1, "flow": 0.35, "spacing": 0.08, "smooth": 0,
          "color": "#000000", "backgroundColor": "#ffffff"
        },
        "operator": {
          "operator": "clone",
          "source": { "anchorLayerId": "layer-source", "point": { "x": 120, "y": 90 } },
          "sampleMode": "current-and-below",
          "sourceOffset": { "x": -80, "y": -40 },
          "diffusion": 5
        }
      },
      "samples": [
        { "x": 200, "y": 130, "pressure": 1 },
        { "x": 260, "y": 150, "pressure": 0.8 }
      ]
    }
  ],
  "selection.applyShape": [
    {
      "mode": "replace",
      "shape": { "kind": "rectangle", "points": [{ "x": 20, "y": 30 }, { "x": 260, "y": 180 }] },
      "featherRadius": 0,
      "antiAlias": false
    }
  ],
  "selection.modify": [
    { "kind": "modify", "operation": "all" },
    { "kind": "modify", "operation": "clear" },
    { "kind": "modify", "operation": "invert" }
  ],
  "grade.setBasic": [
    { "target": { "kind": "document" }, "values": { "exposureEV": 0.35, "contrast": 12 } },
    { "target": { "kind": "layer", "layerId": "layer-photo" }, "values": { "temperature": -8, "vibrance": 15 } }
  ]
}
