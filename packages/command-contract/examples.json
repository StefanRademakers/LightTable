    { "layerId": "layer-shapes", "elementId": "shape-card" }
  ],
  "warp.applyStroke": [
    { "layerId": "layer-photo", "mode": "push",
      "settings": { "diameterPx": 120, "strength": 0.35, "hardness": 0.5,
        "flow": 0.5, "spacing": 0.1, "smooth": 0.2,
        "pressureSize": true, "pressureStrength": true },
      "samples": [
        { "positionPx": [220, 180], "deltaPx": [0, 0], "pressure": 1,
          "tilt": [0, 0], "timeMs": 1000 },
        { "positionPx": [245, 190], "deltaPx": [25, 10], "pressure": 0.8,
          "tilt": [0, 0], "timeMs": 1016 }
      ], "startedAtMs": 1000, "durationMs": 16 }
  ],
  "raster.fill": [
    { "layerId": "layer-photo", "channel": "pixels", "color": "#2f80ed",
      "preserveTransparency": false, "opacity": 1 }
  ],
  "raster.applyGradient": [
    { "layerId": "layer-photo", "channel": "pixels", "opacity": 0.8, "blendMode": "normal",
      "paint": { "kind": "gradient", "shape": "linear", "coordinateSpace": "document",
        "asset": { "id": "agent-sunset", "name": "Agent sunset", "type": "solid",
          "smoothness": 1, "roughness": 0, "seed": 0,
          "colorStops": [
            { "id": "color-start", "position": 0, "midpoint": 0.5,
              "color": { "r": 0.1, "g": 0.2, "b": 0.8, "a": 1 } },
            { "id": "color-end", "position": 1, "midpoint": 0.5,
              "color": { "r": 1, "g": 0.3, "b": 0.1, "a": 1 } }
          ],
          "opacityStops": [
            { "id": "opacity-start", "position": 0, "midpoint": 0.5, "opacity": 1 },
            { "id": "opacity-end", "position": 1, "midpoint": 0.5, "opacity": 1 }
