            { "id": "opaque-1", "position": 1, "midpoint": 0.5, "opacity": 1 }
          ], "roughness": 0, "seed": 0 },
        "shape": "linear", "coordinateSpace": "document",
        "transform": { "a": 900, "b": 0, "c": 0, "d": 900, "tx": 120, "ty": 540 },
        "reverse": false, "dither": true, "interpolation": "perceptual" },
        "stroke": null, "opacity": 1 } }
