      "transform": { "a": 1, "b": 0, "c": 0, "d": 1, "tx": 32, "ty": 24 },
      "style": { "fill": { "type": "solid", "color": [0.1, 0.35, 0.9, 1] }, "opacity": 1 } },
    { "layerName": "Gradient Fill", "layerRole": "gradient-fill", "layerOpacity": 0.8,
      "layerBlendMode": "soft-light", "name": "Gradient Fill",
      "primitive": { "kind": "rectangle", "x": 0, "y": 0, "width": 1920, "height": 1080,
        "cornerRadii": [0, 0, 0, 0], "linkedCorners": true },
      "style": { "fill": { "kind": "gradient",
