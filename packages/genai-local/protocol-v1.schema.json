{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lighttable.local/schemas/ai-provider-v1.json",
  "title": "LightTable AI Provider protocol v1",
  "type": "object",
  "$defs": {
    "operation": { "enum": ["image.create", "image.edit", "image.inpaint"] },
    "multipartImage": {
      "type": "object",
      "required": ["field", "mimeType"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "mimeType": { "enum": ["image/png", "image/jpeg", "image/webp"] }
      },
      "additionalProperties": false
    },
    "jobRequest": {
      "type": "object",
      "required": ["operation", "intent", "modelId", "prompt", "output"],
      "properties": {
        "operation": { "$ref": "#/$defs/operation" },
        "intent": { "type": "string", "minLength": 1 },
        "modelId": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string" },
        "output": {
          "type": "object",
          "required": ["width", "height", "count", "mimeType", "includeAlpha"],
          "properties": {
            "width": { "type": "integer", "minimum": 64 },
            "height": { "type": "integer", "minimum": 64 },
            "count": { "type": "integer", "minimum": 1, "maximum": 4 },
            "mimeType": { "enum": ["image/png", "image/webp"] },
            "includeAlpha": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "seed": { "type": "integer" },
        "baseImage": { "$ref": "#/$defs/multipartImage" },
        "references": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["id", "image"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "image": { "$ref": "#/$defs/multipartImage" },
              "role": { "enum": ["visual", "style", "character", "composition"] }
            },
            "additionalProperties": false
          }
        },
        "selection": {
          "type": "object",
          "required": ["mask", "format", "interpretation"],
          "properties": {
            "mask": { "$ref": "#/$defs/multipartImage" },
            "format": { "enum": ["alpha", "grayscale"] },
            "interpretation": { "enum": ["alpha-is-selected", "white-is-selected"] },
            "featherRadiusPx": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "modelSettings": { "type": "object" },
        "clientMetadata": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
