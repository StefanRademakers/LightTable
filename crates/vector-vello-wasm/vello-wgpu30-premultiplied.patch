-    color::{AlphaColor, ColorSpace, DynamicColor, OpaqueColor, PremulColor, Srgb},
+    color::{AlphaColor, ColorSpace, DynamicColor, LinearSrgb, OpaqueColor, PremulColor},
 };
 
 use super::Monoid;
 
+#[inline]
+fn pack_linear_components([r, g, b, a]: [f32; 4]) -> u32 {
+    let quantize = |value: f32| ((value.clamp(0.0, 1.0) * 255.0) + 0.5) as u32;
+    quantize(r) | (quantize(g) << 8) | (quantize(b) << 16) | (quantize(a) << 24)
+}
+
+pub(crate) fn pack_linear_alpha(color: AlphaColor<LinearSrgb>) -> u32 {
+    pack_linear_components(color.premultiply().components)
+}
